#!/usr/bin/env bash
# Passenger uses bin/python when launching this app. Its platform wrapper tries
# `python`, which may not exist on the OOD host. Use a per-user Python >= 3.11.
set -euo pipefail

if [[ -n "${PROTEIN_OOD_PYTHON:-}" ]]; then
  if ! "$PROTEIN_OOD_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
    echo "PROTEIN_OOD_PYTHON must be Python >= 3.11." >&2
    exit 1
  fi
  exec "$PROTEIN_OOD_PYTHON" "$@"
fi

# The user's home directory is shared with katana3, where uv installed this
# Python. If unavailable on the OOD host, use a site-installed recent Python.
for candidate in \
  "$HOME/.local/share/uv/python/cpython-3.12.9-linux-x86_64-gnu/bin/python3.12" \
  python3.12 python3.11; do
  if command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "$@"
  fi
done

echo "Protein report requires Python >= 3.11 on the OOD host; set PROTEIN_OOD_PYTHON." >&2
exit 1
